{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FS4 Patch Studio",
  "mainBinaryName": "fs4-patch-studio",
  "version": "0.2.1",
  "identifier": "com.sajermann.fs4patchstudio",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Bruno Sajermann",
    "copyright": "GPL-3.0",
    "category": "Utility",
    "shortDescription": "FS4 Patch Studio",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../../backend/dist/fs4-backend/": "backend/",
      "../../LICENSE": "LICENSE",
      "../../NOTICE": "NOTICE"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
